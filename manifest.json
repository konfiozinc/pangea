{
  "name": "PANGEA — Coordinación sin conexión",
  "short_name": "PANGEA",
  "description": "Herramientas de coordinación para comunidades sin conexión: traducción, emparejamiento entre problemas y capacidades, verificación por consenso, archivo del conocimiento y alertas que viajan por USB, Bluetooth o radio. Sin servidores, sin cuentas y sin rastreo.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A0E1A",
  "theme_color": "#6366F1",
  "lang": "es",
  "dir": "ltr",
  "categories": ["education", "productivity", "social", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "handle_links": "preferred",
  "icons": [
    { "src": "assets/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Publicar un problema", "short_name": "Problema", "url": "./index.html#/synapse", "description": "Describe lo que necesita resolverse y busca quien pueda ayudar" },
    { "name": "Emitir una alerta", "short_name": "SOS", "url": "./index.html#/sos", "description": "Alerta de emergencia con ubicación opcional" },
    { "name": "Traducir", "short_name": "LINGUA", "url": "./index.html#/lingua", "description": "Traducción instantánea entre 12 idiomas" },
    { "name": "Archivo del conocimiento", "short_name": "MEMORIA", "url": "./index.html#/memoria", "description": "Preservar y buscar saberes" }
  ],
  "share_target": {
    "action": "./index.html#/memoria",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "protocol_handlers": [
    { "protocol": "web+pangea", "url": "./index.html#/memoria?url=%s" }
  ]
}
